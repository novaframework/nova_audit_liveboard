%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{erl_opts, [debug_info, warnings_as_errors]}.
{src_dirs, [{"src", [{recursive, true}]}]}.
{shell, [{config, "./config/dev_sys.config.src"}]}.

{erlydtl_opts, [
    {doc_root, "src/views"},
    {recursive, true},
    {libraries, [
        {nova_erlydtl_inventory, nova_erlydtl_inventory}
    ]},
    {default_libraries, [nova_erlydtl_inventory]}
]}.

{deps, [
    nova,
    {flatlog, "0.1.2"},
    {nova_audit,
        {git_subdir, "https://github.com/novaframework/nova_audit.git", {tag, "v0.2.0"},
            "apps/nova_audit"}}
]}.

{relx, [
    {release, {nova_audit_liveboard, git}, [
        nova_audit_liveboard,
        sasl
    ]},
    {mode, dev},
    {sys_config_src, "./config/dev_sys.config.src"},
    {vm_args_src, "./config/vm.args.src"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {sys_config_src, "./config/prod_sys.config.src"}
        ]}
    ]},
    {test, [
        {erl_opts, [nowarn_export_all]},
        {deps, [{meck, "1.1.0"}]},
        {ct_opts, [{sys_config, "./config/dev_sys.config.src"}]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_extra_paths, ["test"]}
    ]}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {warnings, [error_handling, unmatched_returns]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{xref_ignores, [
    {nova_audit_liveboard_router, routes, 1},
    {nova_audit_liveboard_main_controller, index, 1}
]}.

{hank, [
    {ignore, [
        "test/**"
    ]}
]}.

{project_plugins, [
    {rebar3_erlydtl_plugin, ".*",
        {git, "https://github.com/erlydtl/rebar3_erlydtl_plugin.git", {branch, "master"}}},
    {rebar3_nova, ".*",
        {git, "https://github.com/novaframework/rebar3_nova.git", {branch, "master"}}},
    {erlfmt, "~>1.7"},
    rebar3_lint,
    rebar3_hank,
    rebar3_ex_doc,
    rebar3_audit,
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    rebar3_mutate
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.app.src",
        "src/**/{*.erl, *.hrl}",
        "test/**/{*.erl, *.hrl}"
    ]},
    {exclude_files, ["config/vm.args.src", "config/prod_sys.config.src"]}
]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => <<"Overview">>}}
    ]},
    {main, <<"readme">>},
    {source_url, <<"https://github.com/novaframework/nova_audit_liveboard">>}
]}.
